<Project>

  <!--
    The repo has a large .editorconfig, but without these it is only ever advice the IDE gives
    one developer. This is what makes CI fail on what it flags.

    Scoped to $(MSBuildProjectName) == 'FrostWoodTech.API' on purpose: the Functions SDK generates a
    WorkerExtensions project underneath obj/ at build time, and we do not control its source or
    its warnings.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'FrostWoodTech.API'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

</Project>
